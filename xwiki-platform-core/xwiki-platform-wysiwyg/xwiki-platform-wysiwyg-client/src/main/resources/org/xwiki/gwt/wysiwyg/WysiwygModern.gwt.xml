<module rename-to="xwe">
  <inherits name="org.xwiki.gwt.wysiwyg.Wysiwyg" />
  <entry-point class="org.xwiki.gwt.wysiwyg.client.Wysiwyg" />
  <!-- Restrict to a single modern user agent to minimize permutations -->
  <set-property name="user.agent" value="safari" />
  <!-- Limit locales to default; applications can override if needed -->
  <set-property name="locale" value="default" />
</module>